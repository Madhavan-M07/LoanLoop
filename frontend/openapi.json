      "LenderPolicy-Input": {
        "additionalProperties": false,
        "description": "An organization's document rules. Required on every organization; there is no default\nin code. Bounds reject values that are clearly a mistake.",
        "properties": {
          "bank_statement_max_age_days": {
            "maximum": 365.0,
            "minimum": 1.0,
            "title": "Bank Statement Max Age Days",
            "type": "integer"
          },
          "max_dti": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 1.0,
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Max Dti"
          },
          "paystub_max_age_days": {
            "maximum": 365.0,
            "minimum": 1.0,
            "title": "Paystub Max Age Days",
            "type": "integer"
          },
          "w2_max_years_back": {
            "description": "Oldest acceptable W-2: year - N",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "W2 Max Years Back",
            "type": "integer"
          }
        },
        "required": [
          "paystub_max_age_days",
          "bank_statement_max_age_days",
          "w2_max_years_back",
          "max_dti"
        ],
        "title": "LenderPolicy",
        "type": "object"
      },
      "LenderPolicy-Output": {
        "additionalProperties": false,
        "description": "An organization's document rules. Required on every organization; there is no default\nin code. Bounds reject values that are clearly a mistake.",
