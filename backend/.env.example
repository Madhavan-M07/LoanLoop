# LoanLoop backend configuration. Copy to backend/.env (never commit .env).
# The app FAILS SAFE: with no config it assumes prod and refuses to start.

# ---- Environment: dev | test | prod (default: prod) ----
LOANLOOP_ENV=dev

# ---- LLM ----
# providers = real models (required in prod) | offline = keyword heuristic, dev/test only
LOANLOOP_LLM_MODE=offline
# Fallback chain, tried in order. api_key_env = NAME of the env var holding the key.
# Check each provider's docs for current model ids before filling these in.
# LOANLOOP_LLM_PROVIDERS_JSON=[{"name":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta/openai/","model":"<gemini-model-id>","api_key_env":"GEMINI_API_KEY"},{"name":"groq","base_url":"https://api.groq.com/openai/v1","model":"<groq-model-id>","api_key_env":"GROQ_API_KEY"}]
# GEMINI_API_KEY=
# GROQ_API_KEY=
LOANLOOP_LLM_TIMEOUT_S=30

# ---- Identities (required in prod) ----
# JSON {"<token>": {"subject","scope":"processor|borrower","org_id","loan_id"?,"via_agent"?}}
# Use long random tokens. Agents (hermes, openclaw) get their own entries with via_agent set.
# LOANLOOP_PRINCIPALS_JSON={"<random-token>":{"subject":"proc-1","scope":"processor","org_id":"<org>"}}

# ---- Demo data (dev/test only; refused in prod) ----
LOANLOOP_DEMO_DATA_PATH=demo/demo_data.json

# ---- Database (optional for now; the in-memory store is still the source of truth) ----
# Local: docker compose -f infra/docker-compose.yml up -d   (throwaway dev password below)
# Driver must be postgresql+asyncpg://
LOANLOOP_DATABASE_URL=postgresql+asyncpg://loanloop:loanloop_dev@127.0.0.1:5432/loanloop
LOANLOOP_DATABASE_TIMEOUT_S=5

# ---- Outbound messages (optional) ----
# LOANLOOP_TELEGRAM_BOT_TOKEN=
LOANLOOP_NOTIFIER_TIMEOUT_S=10

# ---- Pipeline / agent tuning ----
LOANLOOP_CLASSIFY_MIN_CONFIDENCE=0.6
LOANLOOP_MAX_DOCUMENT_CHARS=50000
LOANLOOP_AGENT_MAX_STEPS=5
LOANLOOP_STUCK_AFTER_DAYS=2
